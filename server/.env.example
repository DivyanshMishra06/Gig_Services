# Environment Variables
MONGODB_URI=mongodb://localhost:27017/coop-gig
JWT_SECRET=coop-gig-hackathon-secret-key-2024
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# Optional but recommended for the server-side OpenStreetMap/Nominatim address lookup.
# Use an identifying app/contact string as required by the provider's usage policy.
GEOCODING_USER_AGENT=ActiveSetu/1.0 (contact@example.com)

# Razorpay payment gateway (server-only: never expose these secrets to the client).
RAZORPAY_KEY_ID=rzp_test_your_key_id
RAZORPAY_KEY_SECRET=your_razorpay_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# OpenRouter — CoopGig AI Assistant (server only, never expose to the frontend)
# Get a key at https://openrouter.ai
OPENROUTER_API_KEY=your-openrouter-api-key
OPENROUTER_MODEL=openai/gpt-4o-mini
